# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
#
# ALL services are started with:
#   docker compose up --build   (first time)
#   docker compose up           (subsequent runs)
# ============================================================

# SQL Server SA (system admin) password
# Must satisfy SQL Server complexity: uppercase, lowercase, digit, symbol
SA_PASSWORD=YourStrongSAPassword1!

# App-level DB credentials (created by database/init/01_init.sql)
DB_USERNAME=contact_app_user
DB_PASSWORD=AppUser@2024!

# JWT secret — must be Base64-encoded, at least 32 bytes
# Generate: [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes("your-32-char-secret-here"))
JWT_SECRET=bXktc3VwZXItc2VjcmV0LWtleS0zMi1ieXRlcy1sb25nISE

# SonarQube (only used when started with: docker compose --profile sonar up)
SONAR_TOKEN=replace-with-your-sonarqube-token
SONAR_DB_PASSWORD=sonar
