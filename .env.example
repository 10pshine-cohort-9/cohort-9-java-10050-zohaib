# SQL Server
SA_PASSWORD=YourStrongPassword123!
DB_USERNAME=contact_app_user
DB_PASSWORD=YourAppUserPassword123!

# JWT
JWT_SECRET=replace-with-a-256-bit-random-secret-key

# SonarQube
SONAR_TOKEN=replace-with-your-sonarqube-token
SONAR_DB_PASSWORD=sonar
